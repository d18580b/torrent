[Unit]
Description=torrentd — headless torrent seeding daemon
Documentation=https://github.com/d18580b/torrent
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# No `ExecStartPre=... --check-config`: the daemon makes every check that flag
# makes before it starts anything, and exits 78 for the same refusals.
# RestartPreventExitStatus= reads only the main process's status, so a refusal
# from an ExecStartPre would be restarted every RestartSec regardless.
ExecStart=/usr/bin/torrentd --config /etc/torrentd/torrentd.toml
ExecReload=/bin/kill -HUP $MAINPID
# After every exit of the daemon, clean or not, remove the network state a
# `kill -9`, an OOM kill or a panic abort leaves behind: the kill-switch table
# and the WireGuard links the daemon raised, with their `ip rule`s. After a
# graceful stop it finds nothing. It runs with the capabilities set below, so
# without CAP_NET_ADMIN it does nothing. The `-` keeps a cleanup that could not
# remove everything out of the unit's result: it is logged to the journal, and
# never decides whether the unit restarts.
ExecStopPost=-/usr/bin/torrentd --config /etc/torrentd/torrentd.toml net-cleanup
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s
# 78 (EX_CONFIG) is a configuration the daemon refuses: a config that does not
# load, `nft` missing under `network_kill_switch = true`, or a boot refusal no
# restart can change. Restarting it every RestartSec only buries the reason in
# the journal.
RestartPreventExitStatus=78
WatchdogSec=60s

# Start: tunnel bring-up (up to 30 s a profile) plus the resume and
# torrent-dir scans, minutes at 100K torrents. The daemon sends
# EXTEND_TIMEOUT_USEC every 10 s while it boots, for up to 15 minutes, so
# this bounds a boot that has stopped making progress rather than a large one.
TimeoutStartSec=90s
# Stop: the HTTP drain (10 s), pool work finishing its current step (up to
# 20 s), the resume drain (shutdown_drain_secs, default 60 s), then closing
# the sessions and tunnels: about 95 s at the defaults. The daemon also sends
# EXTEND_TIMEOUT_USEC while it drains, capped at those stages' sum, so a larger
# shutdown_drain_secs is covered; keep this above the defaults' total so a
# stop is bounded even where the extensions do not arrive.
TimeoutStopSec=120s

# Resource limits Environment.
LimitNOFILE=65536
TasksMax=8192

# Sandboxing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
# Other users' processes are invisible. The daemon only ever signals its own
# children (the OpenVPN process it started), which run as its own uid.
ProtectProc=invisible
RestrictNamespaces=yes
# AF_UNIX for sd_notify, AF_INET/AF_INET6 for peers, trackers and the API,
# AF_NETLINK for `ip`, `wg` and `nft`, which inherit this list when the daemon
# runs them to manage tunnels and the kill switch.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# State + data dirs the daemon may write. `ProtectSystem=strict` makes every
# other path read-only, so this must name every directory the daemon writes:
# the state dir, every `default_save_path`/`save_path` payload lands under,
# every `[pool] roots` entry and its `library_dir` (a plan moves and deletes
# payload there), and any `resume_dir`/`torrent_dir` a `[[profile]]` moves
# elsewhere. A pool root missing here fails every mutation plan with EROFS.
ReadWritePaths=/var/lib/torrentd /data/torrents
StateDirectory=torrentd
StateDirectoryMode=0750

# WireGuard / tunnel control. A `network = "vpn"` profile brings up its own
# tunnel (and, with `network_kill_switch = true`, installs an nftables table),
# and needs NET_ADMIN. The daemon never runs `wg-quick`: it raises WireGuard
# links with `ip` and `wg`, which need only this capability, and routes each
# one by source address. The WireGuard configs must be readable by the
# torrentd group and carry no PostUp/PreDown hooks — docs/running.md §11.6.
#
# The two directives pull in opposite directions and are treated differently
# here. `AmbientCapabilities=` is a grant, so it is commented out by default: a
# capability granted to a deployment that does not need it is a capability
# granted for nothing. `CapabilityBoundingSet=` is a ceiling, so commenting it
# out grants rather than withholds — it replaces a bounding set of exactly
# CAP_NET_ADMIN with systemd's full default set, and every binary the daemon
# execs (`nft`, `ip`, `wg`, `pkill`) can then acquire whatever file
# capabilities it carries. It is therefore active and empty below: nothing this
# unit runs can hold any capability at all.
#
# For a `vpn` profile, uncomment both lines. They come after the empty set, so
# the bounding set ends up as exactly {CAP_NET_ADMIN} without deleting
# anything.
CapabilityBoundingSet=
# AmbientCapabilities=CAP_NET_ADMIN
# CapabilityBoundingSet=CAP_NET_ADMIN

User=torrentd
Group=torrentd

[Install]
WantedBy=multi-user.target
