[Unit]
Description=torrentd — headless torrent seeding daemon
Documentation=https://github.com/d18580b/torrent
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/torrentd --config /etc/torrentd/torrentd.toml --check-config
ExecStart=/usr/bin/torrentd --config /etc/torrentd/torrentd.toml
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s
WatchdogSec=60s

# Resource limits Environment.
LimitNOFILE=65536
TasksMax=8192

# Sandboxing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# State + data dirs the daemon may write.
ReadWritePaths=/var/lib/torrentd /data/torrents
StateDirectory=torrentd
StateDirectoryMode=0750

# WireGuard / tunnel control. A `network = "vpn"` profile needs NET_ADMIN.
#
# The two directives pull in opposite directions and are treated differently
# here. `AmbientCapabilities=` is a grant, so it is commented out by default: a
# capability granted to a deployment that does not need it is a capability
# granted for nothing. `CapabilityBoundingSet=` is a ceiling, so commenting it
# out grants rather than withholds — it replaces a bounding set of exactly
# CAP_NET_ADMIN with systemd's full default set, and every binary the daemon
# execs (`nft`, `wg`, `wg-quick`, `pkill`) can then acquire whatever file
# capabilities it carries. It is therefore active and empty below: nothing this
# unit runs can hold any capability at all.
#
# For a `vpn` profile, uncomment both lines. They come after the empty set, so
# the bounding set ends up as exactly {CAP_NET_ADMIN} without deleting
# anything.
CapabilityBoundingSet=
# AmbientCapabilities=CAP_NET_ADMIN
# CapabilityBoundingSet=CAP_NET_ADMIN

User=torrentd
Group=torrentd

[Install]
WantedBy=multi-user.target
