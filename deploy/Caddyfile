# Reverse proxy for torrentd. TLS terminates here and nowhere else.
#
# torrentd deliberately does not speak TLS: it has no certificate handling, no
# renewal, and no HTTP server configuration surface to get wrong. This proxy
# terminates TLS and forwards. Every API response is `Cache-Control: no-store`
# — it describes live daemon state behind a credential — so there is nothing
# here to cache.
#
# Replace the site address with your own. `torrentd.example.com` gets an
# automatic certificate; `:80` alone serves plain HTTP, which is fine on a
# private network and is not fine anywhere else.

# Client timeouts, so a connection that never finishes its request head, or
# never sends a next one, is closed here rather than held open against the
# daemon's 256-connection cap. Caddy sets neither by default.
#
# There is deliberately no `read_body`. Caddy streams a request body upstream
# as it arrives, and the daemon bounds every body itself: it checks the
# credential before reading one, and cuts off a body that has not arrived
# within 30 s (300 s for `POST /v1/torrents`) with 408. `read_body` is Go's
# read deadline for the whole request, and it can cut off a long-lived
# `/v1/events` stream too, so setting it trades a bound the daemon already
# has for an event stream that drops.
{
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

torrentd.example.com {
	encode zstd gzip

	# The largest body the API accepts: `POST /v1/torrents`, whose 96 MiB
	# limit is the daemon's own (`MAX_ADD_BODY_BYTES`). A larger one is
	# refused here with 413 before any of it is forwarded.
	request_body {
		max_size 96MiB
	}

	# The headers torrentd reads: X-Forwarded-For, X-Forwarded-Proto and
	# RFC 7239 Forwarded. All three, which is why there are three
	# `header_up` lines below and not two. It reads them
	# **only** from a peer listed in `trusted_proxies`, so set that to this
	# container's address on the compose network — 172.28.0.2, which
	# `deploy/compose.yaml` pins so there is a fixed address to name. Get it
	# wrong and they are ignored and the daemon falls back to the socket peer.
	#
	# Adapting this to nginx or Traefik means carrying all three across.
	# Setting only the two `X-` names leaves `Forwarded` a client-controlled
	# input arriving from a peer this daemon believes, and where an `X-` name
	# is absent the client's `Forwarded` is what the daemon reads.
	reverse_proxy torrentd:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# Strip anything the *client* sent under these names before adding
		# ours. Without this, a client can prepend entries to the chain.
		# torrentd reads the last entry for the client's address — but the
		# *whole chain* for the scheme, since TLS is terminated at the edge
		# and any hop that says `https` answers it — so a prepended `https` is
		# believed unless it is stripped here, and a proxy that forwards
		# client-supplied values is a proxy that cannot be trusted about
		# anything.
		header_up -Forwarded
	}

	# Nothing here for /v1/events, deliberately. The SSE stream must not be
	# buffered or it arrives in one lump at timeout, and Caddy already
	# disables buffering for a `text/event-stream` response, so the stream
	# works by default rather than by configuration.
	#
	# A second `reverse_proxy @events` block would in any case be dead: Caddy
	# preserves source order between two instances of one directive in a site
	# block, and the block above carries no matcher, so it matches
	# /v1/events first and terminates the handler chain. Were it ever made
	# reachable it would proxy /v1/events *without* the `header_up` rules
	# above, i.e. with client-supplied forwarding headers intact to a peer
	# torrentd trusts.
	#
	# A hand-rolled nginx config is the common place this does go wrong:
	# there it needs `proxy_buffering off` on /v1/events.
}
