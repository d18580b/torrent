# Multi-stage Containerfile for torrentd.
#
# Stage 1 (builder): Fedora with gcc/cmake/openssl-dev + Rust via rustup.
# Compiles vendored Boost + libtorrent + the shim + the daemon.
# Stage 2 (runtime): Fedora minimal plus the runtime tools listed below.
#
# Each release publishes this image as ghcr.io/d18580b/torrent:X.Y.Z, built
# by .github/workflows/release-plz.yml from the tagged commit with no build
# cache, checked to carry that release's torrentd, then signed and attested
# (README.md § Install says how to verify it).
#
# Both base images are pinned by the digest of their multi-arch index, not by
# tag alone: `fedora:43` is re-pushed with every update, so a tag names a
# different image from one build to the next and nothing records which one a
# given torrentd image was built on. The tag stays for the reader; the digest
# is what is pulled. To move a pin, read the index digest a tag currently
# names and replace it:
#
#   skopeo inspect --raw docker://registry.fedoraproject.org/fedora:43 | sha256sum

FROM registry.fedoraproject.org/fedora:43@sha256:4f128be2ec20ffa551ec33add60f8bfd0cf60f7c6d3f1026206f0cf731b3a1f2 AS builder

RUN dnf install -y \
        gcc-c++ make cmake ninja-build pkgconf-pkg-config \
        openssl-devel clang-devel \
        git curl ca-certificates \
    && dnf clean all

# Rust toolchain — rustup installs no toolchain here; the build below fetches
# the exact release rust-toolchain.toml pins, so the image builds with the
# same compiler as CI and a developer.
#
# rustup-init itself is a pinned release, fetched from rustup's versioned
# archive and checked against the SHA-256 recorded here before it runs: the
# unversioned `sh.rustup.rs` script runs whatever the server returns that day.
# Each checksum is the `rustup-init.sha256` rustup publishes next to the
# binary, at
#   https://static.rust-lang.org/rustup/archive/<version>/<triple>/rustup-init.sha256
# and the three values move together. An architecture with no checksum here
# fails this step rather than running an unverified installer.
#
# Every command is joined by `&&`, so a failed download or a checksum mismatch
# fails this step with its own error. `echo ... | sha256sum -c -` is the one
# pipeline, and its status is `sha256sum`'s, which is the one that matters.
# `SHELL ["/bin/bash", "-o", "pipefail", "-c"]` is not used because podman's
# default OCI image format ignores `SHELL`.
ARG RUSTUP_VERSION=1.29.2
ARG RUSTUP_INIT_SHA256_X86_64=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
ARG RUSTUP_INIT_SHA256_AARCH64=a9c168dbea81a84671c6b7a5c1795cb0eb699020110d107ddfca427bd797e697
RUN arch=$(uname -m) \
    && case "$arch" in \
         x86_64) sha=$RUSTUP_INIT_SHA256_X86_64 ;; \
         aarch64) sha=$RUSTUP_INIT_SHA256_AARCH64 ;; \
         *) echo "no pinned rustup-init checksum for $arch" >&2; exit 1 ;; \
       esac \
    && curl --proto '=https' --tlsv1.2 -sSf -o /tmp/rustup-init \
         "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${arch}-unknown-linux-gnu/rustup-init" \
    && echo "$sha  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --default-toolchain none --profile minimal \
    && rm /tmp/rustup-init
ENV PATH=/root/.cargo/bin:${PATH}

WORKDIR /src
COPY . /src

# Where libtorrent-sys keeps its content-addressed native prefixes. Mounted
# as a build cache below so repeated local image builds reuse the Boost +
# libtorrent build instead of spending 6-15 minutes on it every time.
#
# .dockerignore excludes .git/, so build.rs cannot read the submodule gitlinks
# here and identifies the vendored trees by hashing marker files instead. That
# is deterministic across builds, which is what makes the mount worth having.
#
# Note this helps local iteration only: the CI `container` job and the release
# workflow's `image` job run on a fresh VM, where a build cache mount starts
# empty.
ENV LIBTORRENT_SYS_CACHE_DIR=/root/.cache/torrentd/native

# Extra cargo features, empty for every image but the alert drill's, which
# passes `torrentd/fault-injection` (deploy/drill/compose.yaml). That feature
# mounts an endpoint that injects faults into the daemon, so an image built
# with it is a test fixture and never a deployment: its daemon exits 78 at
# startup unless TORRENTD_FAULT_INJECTION=1, which only the drill sets.
ARG CARGO_FEATURES=""

# `cargo build --release` will re-read rust-toolchain.toml and download
# the matching channel automatically.
RUN --mount=type=cache,target=/root/.cache/torrentd,sharing=locked \
    --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    cargo build --release --workspace --bin torrentd \
        ${CARGO_FEATURES:+--features "$CARGO_FEATURES"}

# ---- runtime --------------------------------------------------------------

# `fedora-minimal:43`, not `fedora:43-minimal` — the latter is not a tag that
# exists in any registry, so the runtime stage could never be pulled. Pinned by
# index digest for the reason given at the top of this file.
FROM registry.fedoraproject.org/fedora-minimal:43@sha256:faf83ebf1612b5c8da396dce424f2d4ac7ec1b9ac0e0b7c6cdb863259ee74f05

# **This runtime layer is WireGuard-only.** No `openvpn` binary is installed
# and none ever has been, so a profile configured `vpn_type = "openvpn"` cannot
# come up in this image: bring-up fails, the profile is fenced, and with no other
# profile the daemon exits. Install `openvpn` here, or run that configuration on
# a host, if you need it. `ip` (iproute), `wg` (wireguard-tools) and `nft`
# (nftables) are the whole of what the daemon shells out to in this image: it
# raises every WireGuard link itself and never runs `wg-quick`.
#
# The rest:
#   curl        HEALTHCHECK below.
#   coreutils   `stty`, which `torrentd hash-password` needs to hide the
#               password; already in the base, declared rather than inherited.
#   procps-ng   `sysctl`, without which a by-hand `wg-quick` of a full-tunnel
#               (`AllowedIPs = 0.0.0.0/0`) config inside the image deletes the
#               link it just raised; also `ps`, `pgrep`, `pkill` for an
#               operator who `podman exec`s in. A runtime dependency of a
#               binary the daemon execs is not found by grepping this
#               repository: check `ip`, `wg` and `nft` before removing it.
RUN microdnf install -y \
        openssl ca-certificates curl iproute wireguard-tools nftables procps-ng \
        coreutils \
    && microdnf clean all

COPY --from=builder /src/target/release/torrentd /usr/local/bin/torrentd
COPY deploy/torrentd.sample.toml /etc/torrentd/torrentd.toml.sample

# State directories (persisted via a volume mount in compose.yaml).
# Owned by the unprivileged uid the container runs as, not root: these are
# created 0755 root-owned otherwise, and the daemon then cannot write its own
# resume data unless a volume mount happens to mask them.
RUN mkdir -p /var/lib/torrentd/resume /var/lib/torrentd/torrents /data/torrents \
    && chown -R 1000:1000 /var/lib/torrentd /data/torrents

EXPOSE 6881/tcp 6881/udp 8080/tcp

# Drop privileges. A `network = "vpn"` profile needs CAP_NET_ADMIN at runtime
# to bring up its tunnel; in that case run as root with `cap_add: NET_ADMIN`.
USER 1000:1000

# The image's only health check. It survives in a Docker-format image alone:
# podman and buildah drop it from their default OCI format, so `mise run
# container` builds with `--format docker`, and a podman build of compose.yaml
# needs BUILDAH_FORMAT=docker (docs/running.md §8). docker and buildx, which
# the release workflow uses, keep it.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/torrentd", "--config", "/etc/torrentd/torrentd.toml"]
