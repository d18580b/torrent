# Multi-stage Containerfile for torrentd.
#
# Stage 1 (builder): Fedora with gcc/cmake/openssl-dev + Rust via rustup.
# Compiles vendored Boost + libtorrent + the shim + the daemon.
# Stage 2 (runtime): Fedora minimal + just OpenSSL + ca-certificates.

FROM registry.fedoraproject.org/fedora:43 AS builder

RUN dnf install -y \
        gcc-c++ make cmake ninja-build pkgconf-pkg-config \
        openssl-devel clang-devel \
        git curl ca-certificates \
    && dnf clean all

# Rust toolchain — pinned to whatever rust-toolchain.toml in the repo
# requests (currently 1.90).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain none --profile minimal
ENV PATH=/root/.cargo/bin:${PATH}

WORKDIR /src
COPY . /src

# Where libtorrent-sys keeps its content-addressed native prefixes. Mounted
# as a build cache below so repeated local image builds reuse the Boost +
# libtorrent build instead of spending 6-15 minutes on it every time.
#
# .dockerignore excludes .git/, so build.rs cannot read the submodule gitlinks
# here and identifies the vendored trees by hashing marker files instead. That
# is deterministic across builds, which is what makes the mount worth having.
#
# Note this helps local iteration only: the CI `container` job runs on a fresh
# VM, where a build cache mount starts empty.
ENV LIBTORRENT_SYS_CACHE_DIR=/root/.cache/torrentd/native

# Extra cargo features, empty for every image but the alert drill's, which
# passes `torrentd/fault-injection` (deploy/drill/compose.yaml). That feature
# mounts an endpoint that injects faults into the daemon, so an image built
# with it is a test fixture and never a deployment.
ARG CARGO_FEATURES=""

# `cargo build --release` will re-read rust-toolchain.toml and download
# the matching channel automatically.
RUN --mount=type=cache,target=/root/.cache/torrentd,sharing=locked \
    --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    cargo build --release --workspace --bin torrentd \
        ${CARGO_FEATURES:+--features "$CARGO_FEATURES"}

# ---- runtime --------------------------------------------------------------

# `fedora-minimal:43`, not `fedora:43-minimal` — the latter is not a tag that
# exists in any registry, so the runtime stage could never be pulled.
FROM registry.fedoraproject.org/fedora-minimal:43

# **This runtime layer is WireGuard-only.** No `openvpn` binary is installed
# and none ever has been, so a profile configured `vpn_type = "openvpn"` cannot
# come up in this image: bring-up fails, the profile is fenced, and with no other
# profile the daemon exits. Install `openvpn` here, or run that configuration on
# a host, if you need it. `ip`, `wg`, `wg-quick` and `nft` are the whole of
# what the daemon shells out to in this image.
#
# curl: used by HEALTHCHECK below.
#
# `/usr/bin/kill` is the **daemon's** hard runtime dependency for
# vpn_type = "openvpn": the OpenVPN teardown shells out to `kill` against a pid
# it has verified against /proc/<pid>/cmdline, and `Command` spawns no shell,
# so the builtin is not reachable. That is a statement about the daemon and
# about the hosts that run that configuration — not about this image, which
# does not. It is recorded here because the binary comes from **util-linux** —
# `util-linux-core` on this base image, where `rpm -qf /usr/bin/kill` prints
# util-linux-core-2.41.5-1.fc43 — and is already in fedora-minimal, so nothing
# is installed for it here. An image working by inheritance rather than by
# declaration is what let the runbook name the wrong package for two rounds.
#
# `procps-ng` is **not** where `kill` comes from: that package ships `pgrep`
# and `pkill` and no `kill`. It is installed all the same, and the consumer is
# **`wg-quick`, not this repository's source**.
#
# `wg-quick` line 241, inside `add_default()` and under `set -e -o pipefail`:
#
#     [[ $proto == -4 ]] && [[ $(sysctl -n net.ipv4.conf.all.src_valid_mark) -ne 1 ]] \
#         && cmd sysctl -q net.ipv4.conf.all.src_valid_mark=1
#
# `/usr/sbin/sysctl` belongs to `procps-ng` — `rpm -qf /usr/sbin/sysctl` in
# this base prints procps-ng-4.0.4-7.fc43.1. Without it the substitution
# yields the empty string, `[[ "" -ne 1 ]]` is true, and the final `cmd
# sysctl` — the command after the last `&&`, which `set -e` does not exempt —
# exits 127. `cmd_up`'s `trap 'del_if; exit' INT TERM EXIT` then deletes the
# link it has just created. That path runs for `AllowedIPs = 0.0.0.0/0`, the
# full-tunnel shape every commercial provider uses and the one
# `deploy/torrentd.sample.toml` names for ProtonVPN and PIA, so dropping this
# package means **no WireGuard profile can come up in this image** and the daemon
# exits because no profile came up. A narrow `AllowedIPs` never reaches
# `add_default()` and is unaffected, which is what makes the breakage easy to
# miss.
#
# The package was once here for a pattern-based `pkill` teardown that a
# recycled pid made unsafe; that call site is gone, and it was dropped on the
# evidence that `grep -rn 'pkill|pgrep' crates/` returns nothing. That search
# was of **this repository's source**, for two of the package's binaries; the
# dependency is a third binary, in a tool the daemon execs. The standing
# lesson, recorded where the next reader meets it: **a runtime dependency of a
# binary this daemon execs is not discoverable by grepping this repository.**
# Before removing this package again, establish that nothing the daemon execs
# — `ip`, `wg`, `wg-quick`, `nft` — needs it.
#
# It also happens to restore the process-inspection tools (`ps`, `pgrep`,
# `pkill`) for an operator who `podman exec`s in. That is a side effect, not
# the reason.
RUN microdnf install -y \
        openssl ca-certificates curl iproute wireguard-tools nftables procps-ng \
    && microdnf clean all

COPY --from=builder /src/target/release/torrentd /usr/local/bin/torrentd
COPY deploy/torrentd.sample.toml /etc/torrentd/torrentd.toml.sample

# State directories (persisted via a volume mount in compose.yaml).
# Owned by the unprivileged uid the container runs as, not root: these are
# created 0755 root-owned otherwise, and the daemon then cannot write its own
# resume data unless a volume mount happens to mask them.
RUN mkdir -p /var/lib/torrentd/resume /var/lib/torrentd/torrents /data/torrents \
    && chown -R 1000:1000 /var/lib/torrentd /data/torrents

EXPOSE 6881/tcp 6881/udp 8080/tcp

# Drop privileges. The container needs CAP_NET_ADMIN at runtime if
# multi-slot mode brings up VPN tunnels itself; in that case run as
# root with `cap_add: NET_ADMIN`.
USER 1000:1000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/torrentd", "--config", "/etc/torrentd/torrentd.toml"]
