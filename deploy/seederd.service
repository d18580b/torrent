[Unit]
Description=seederd — headless torrent seeding daemon
Documentation=https://github.com/justin13888/milkyisles
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/seederd --config /etc/seederd/seederd.toml --check-config
ExecStart=/usr/bin/seederd --config /etc/seederd/seederd.toml
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s
WatchdogSec=60s

# Resource limits per PRD §Target Environment.
LimitNOFILE=65536
TasksMax=8192

# Sandboxing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# State + data dirs the daemon may write.
ReadWritePaths=/var/lib/seederd /data/torrents
StateDirectory=seederd
StateDirectoryMode=0750

# WireGuard / tunnel control. Multi-slot mode needs NET_ADMIN; remove
# both lines if you only run single-session mode.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

User=seederd
Group=seederd

[Install]
WantedBy=multi-user.target
