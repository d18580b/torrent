# Vendored third-party sources should not skew language stats or trigger reviews.
vendor/** linguist-vendored=true
vendor/** linguist-generated=true

# Generated bindings live in OUT_DIR (see crates/libtorrent-sys/build.rs), not
# in src/, so there is no path here to mark.

# Normalize line endings
*           text=auto eol=lf
*.sh        text eol=lf
*.bat       text eol=crlf

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.torrent   binary
*.resume    binary
