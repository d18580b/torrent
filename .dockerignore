# Build context for deploy/Containerfile. compose.yaml sets `context: ..`, so
# without this every build streams the whole working tree — a warm `target/`
# alone is gigabytes, and none of it is used: the builder stage compiles from
# source inside the image.
target/
.git/
*.db
*.db-wal
*.db-shm
*.resume
*.resume.tmp
# The operator's config compose.yaml mounts. It holds the argon2 hash and any
# tokens, and `COPY . /src` would otherwise put it in the builder's layer cache.
deploy/torrentd.toml
